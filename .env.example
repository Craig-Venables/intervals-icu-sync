# Copy this file to .env and fill in your values.
# Get credentials from https://intervals.icu/settings (Developer Settings).
#
# Never commit .env — it is listed in .gitignore.

# API key from intervals.icu Developer Settings
INTERVALS_API_KEY=

# Optional: athlete ID from intervals.icu settings (for example iXXXXXX).
# Leave blank or set to 0 to use the athlete linked to your API key.
INTERVALS_ATHLETE_ID=0
